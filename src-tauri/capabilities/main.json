{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "ReviewDesk main window capability with no filesystem, shell, process, or HTTP plugin access.",
  "windows": ["main"],
  "permissions": [
    "allow-cancel-codex-chatgpt-login",
    "allow-cancel-github-oauth",
    "allow-collect-pr-context",
    "allow-confirm-submit-review",
    "allow-create-draft-from-run",
    "allow-generate-review-draft",
    "allow-get-ai-connection-status",
    "allow-get-app-status",
    "allow-get-codex-bridge-status",
    "allow-list-ai-models",
    "allow-list-review-drafts",
    "allow-list-repositories",
    "allow-load-review-queue",
    "allow-logout-github",
    "allow-logout-codex-chatgpt",
    "allow-mark-active-draft",
    "allow-open-external-url",
    "allow-poll-chatgpt-oauth",
    "allow-poll-codex-chatgpt-login",
    "allow-poll-github-oauth",
    "allow-prepare-submit-review",
    "allow-validate-inline-comments",
    "allow-read-codex-account",
    "allow-read-codex-rate-limits",
    "allow-read-review-draft",
    "allow-refresh-ai-account-status",
    "allow-refresh-github-auth-status",
    "allow-save-draft",
    "allow-save-review-draft",
    "allow-select-ai-model",
    "allow-set-private-diff-consent",
    "allow-start-agent-run",
    "allow-start-chatgpt-oauth",
    "allow-start-codex-chatgpt-login",
    "allow-start-github-oauth",
    "allow-read-agent-run",
    "allow-cancel-agent-run",
    "core:app:default",
    "core:event:default",
    "core:path:default",
    "core:window:default",
    "opener:allow-open-url"
  ]
}
